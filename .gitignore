*.egg-info/
*.pyc
.DS_Store
.venv/
__pycache__/
results/
wandb/

# lambda_ab.sh orchestrator: local instance state + any host logs tee'd locally
runs/.lambda_ab.state
runs/.runpod_ab.state
runs/.runpod_stp_ab.state
runs/.stp_ctrl.state
runs/*.log

# rustbpe build artifacts (cargo target dirs; per-crate uv.lock from maturin builds)
# The crate sources (Cargo.toml, Cargo.lock, src/, pyproject.toml, README.md) are tracked;
# everything cargo / maturin produces during a build is not.
rustbpe/target/
rustbpe/uv.lock
rustbpe_variants/*/target/
rustbpe_variants/*/uv.lock
